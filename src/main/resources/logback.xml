	<!-- http CALL -->



<!--	추후 socket 등을 연계하고 난 후 로그를 해당 명칭으로 지정-->
	<logger name="com.eseict.apiServer.proc" additivity="false">
		<level value = "info"></level>
		<appender-ref ref = "frameworkconsole"></appender-ref>
		<appender-ref ref = "MSG_FILE"></appender-ref>
	</logger>


	<!-- Root Logger -->
	<root level="info">
		<appender-ref ref="frameworkconsole"/>
		<appender-ref ref="COM_FILE"/>
	</root>

</configuration>
