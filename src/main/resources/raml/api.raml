          type: string
          description: 등록일자
          required: true
          example: "202010071641123"
        regUser:
          type: string
          description: 등록자
          required: false
          example: "koojy"
      body:
        application/json:
          type: dstrgroup
      responses:
        201:
          description: 정상적으로 재난 그룹이 등록됐을 경우
