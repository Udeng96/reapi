#전파
/dstrevets:
  description: 재난 상황 이력
  get:
    description: 재난 상황 이력 목록 조회
    queryParameters:
      statEvetOutbSeqn :
        displayName: StatEvent Outbreak Sequence
        type: string
        required: false
        description: 이벤트 아이디
        example : "E_eqHPDb30k8obbBG44YA9AX"
    responses:
      200:
        description: 정상적으로 재난 상황 이력 목록이 요청됐을 경우
        body:
          application/json:
            type: dstrEvetHist_id[]
  post:
    description: 재난 상황 이력 등록
    queryParameters:
      title:
        type: string
        description: 재난 상황 이력 제목
        required: false
        example: "화재발생"
      content:
        type: string
        description: 재난 상황 이력 내용
        required: false
        example: "화재가 발생했습니다."
      propagationTarget:
        type: string
        description: 전파대상(아래 예시 중 적절한 경우를 선택할 것)
        required: false
      propagationTarget_sample001:
        type: string
        description: 전파대상(전파의 경우 ... type=1)
        required: false
        example: "[{systemCd: '001', name: '홈페이지'}, {systemCd: '002', name: '미추홀콜센터'}]"
      propagationTarget_sample002:
        type: string
        description: 전파대상(공유의 경우 ... type=2)
        required: false
        example: "[{userLoginId: 'eseLoginId001', userName: '이에스이 사용자 001', userId: 'shASfchw8crfakjfcnw', cpNo: '01012341234'}]"
      propagationTarget_sample003:
        type: string
        description: 전파대상(SMS의 경우 ... type=3)
        required: false
        example: "[{userLoginId: 'eseLoginId001', userName: '이에스이 사용자 001', userId: 'shASfchw8crfakjfcnw', cpNo: '01012341234'}]"
      statEvetOutbSeqn:
        type: string
        description: 상황 이벤트 발생 시퀀스(아이디)
        required: false
        example: "E_83qharusfdshanwiuyct"
      type:
        type: number
        description: 재난 상황 이력 종류(전파=1, 공유=2, SMS=3)
        required: false
        example: "E_83qharusfdshanwiuyct"
    body:
    application/json:
      type: dstrEvetHist
    responses:
      201:
        description: 정상적으로 재난 상황 이력이 등록됐을 경우
        headers:
          Content-Location:
            description: 생성된 재난 상황 이력 데이터 요청 URL
            displayName: ContentLocation
            type: string
            required: false
        body:
          application/json:
            properties:
              message:
                description: 재난 상황 이력 등록 결과 메세지
                type: string
                required: false
                example: !include ../raml/example/common/message_success.json
  /{dstrEvetHistId}:
    uriParameters:
      dstrEvetHistId:
        type: string
        description: 재난 상황 이력 아이디
        example: "dstr_6usZO3IXkl68HzEhLZd-RZ"
    get:
      description: 재난 상황 이력 단건 조회
      responses:
        200:
          description: 정상적으로 재난 상황 이력 단건이 요청됐을 경우
          body:
            application/json:
              type: dstrEvetHist_id
    delete:
      description: 재난 상황 이력 삭제
      responses:
        200:
          description: 정상적으로 재난 상황 이력이 삭제됐을 경우
          body:
            application/json:
              properties:
                message:
                  description: 재난 상황 이력 삭제 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
    /files:
      get:
        description: 재난 상황 이력 첨부파일 목록 조회
        responses:
          200:
            description: 정상적으로 재난 상황 이력 첨부파일 목록이 요청됐을 경우
            body:
              application/json:
                type: dstrEvetFile_id[]
      post:
        description: 재난 상황 이력 첨부파일 등록
        body:
          multipart/form-data:
            properties:
              fileData:
                type: file
                description: 첨부 파일(MultipartFile)
                required: false
                example: include Some File
        responses:
          201:
            description: 정상적으로 재난 상황 이력 첨부파일이 등록됐을 경우
            headers:
              Content-Location:
                description: 생성된 재난 상황 이력 첨부파일 데이터 요청 URL
                displayName: ContentLocation
                type: string
                required: false
            body:
              application/json:
                properties:
                  message:
                    description: 재난 상황 이력 첨부파일 등록 결과 메세지
                    type: string
                    required: false
                    example: !include ../raml/example/common/message_success.json
      /{dstrEvetHistFileMappId}:
        /download:
          description: 파일 다운로드
          get:
            description: 파일 다운로드
            responses:
              200:
                body:
                  multipart/form-data:
                    type: file (MultipartFile fileData)
                    example: Download Some File
        delete:
          description: 재난 상황 이력 첨부파일 삭제
          responses:
            200:
              description: 정상적으로 재난 상황 이력 첨부파일이 삭제됐을 경우
              body:
                application/json:
                  properties:
                    message:
                      description: 재난 상황 이력 첨부파일 삭제 결과 메세지
                      type: string
                      required: false
                      example: !include ../raml/example/common/message_success.json
    /cctvs:
      get:
        description: 재난 상황 이력 CCTV 목록 조회
        responses:
          200:
            description: 정상적으로 재난 상황 이력 CCTV 목록이 요청됐을 경우
            body:
              application/json:
                type: dstrEvetCctv_id[]
      post:
        description: 재난 상황 이력 CCTV 등록
        body:
        application/json:
          type: dstrEvetCctv
        responses:
          201:
            description: 정상적으로 재난 상황 이력 CCTV가 등록됐을 경우
            headers:
              Content-Location:
                description: 생성된 재난 상황 이력 CCTV 데이터 요청 URL
                displayName: ContentLocation
                type: string
                required: false
            body:
              application/json:
                properties:
                  message:
                    description: 재난 상황 이력 CCTV 등록 결과 메세지
                    type: string
                    required: false
                    example: !include ../raml/example/common/message_success.json
      /{dstrEvetHistCctvMappId}:
        delete:
          description: 재난 상황 이력 CCTV 삭제
          responses:
            200:
              description: 정상적으로 재난 상황 이력 CCTV가 삭제됐을 경우
              body:
                application/json:
                  properties:
                    message:
                      description: 재난 상황 이력 CCTV 삭제 결과 메세지
                      type: string
                      required: false
                      example: !include ../raml/example/common/message_success.json

#청소차량
/cleancars:
  description: 청소차량
  #전체 청소차량 실시간 위치
  get:
    description: 전체 청소차량 실시간 위치
    responses:
      200:
        description: 정상적으로 청소차량 실시간 위치가 요청됐을 경우
        body:
          application/json:
            type: cleancar_realtime[]
            example: !include example/cleancar/get_cleancar_realtime.json
  #특정 청소차량 이력
  /{vin}:
    uriParameters:
      vin:
        type: string
        description: 차량번호
        required: false
        example: "00가0000"
    get:
      description: 특정 청소차량 이력
      responses:
        200:
          description: 정상적으로 특정 청소차량 이력이 요청됐을 경우
          body:
            application/json:
              type: cleancar_history[]
              example: !include example/cleancar/get_cleancar_history.json