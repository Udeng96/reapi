#%RAML 1.0
title: Incheon API RAML Document
version: 0.2
protocols: [HTTP]
mediaType: application/json
baseUri: http://{domain}:{port}/api
baseUriParameters:
  domain:
    type : string
    description: API 서버가 설치된 도메인
  port:
    type : integer
    description: API 서버 접속 포트(80인 경우 생략)
description: 인천 API 문서

types:
  mainArea:
    type: object
    displayName: 주요구역
    description: 주요구역
    required: false
    properties:
      mainAreaName:
        type: string
        description: 주요구역 이름
        required: false
      mainAreaGeojson:
        type: string
        description: 주요구역 도형 데이터
        required: false
      regUser:
        type: string
        description: 주요구역 등록자명
        required: false
      regDate:
        type: string
        description: 주요구역 등록일자
        required: false
  mainArea_id:
    type: mainarea
    displayName: 주요구역
    description: 주요구역 아이디
    required: false
    properties:
      mainAreaId:
        type: string
        description: 주요구역 아이디
        required: false
  route:
    type: object
    displayName: 경로
    description: 경로
    required: false
    properties:
      routeName:
        type: string
        description: 경로명
        required: false
      regUser:
        type: string
        description: 등록자명
        required: false
      regDate:
        type: string
        description: 등록일자
        required: false
  route_id:
    type: route
    displayName: 경로
    description: 경로
    required: false
    properties:
      routeId:
        type: string
        description: 경로 아이디
        required: false
  location:
    type: object
    displayName: 위치
    description: 위치
    required: false
    properties:
      routeId:
        type: string
        description: 경로 아이디
        required: false
      lon:
        type: string
        description: 경도
        required: false
      lat:
        type: string
        description: 위도
        required: false
      address:
        type: string
        description: 주소
        required: false
  loc_id:
    type: location
    displayName: 위치
    description: 위치
    required: false
    properties:
      locId:
        type: string
        description: 위치 아이디
        required: false
  cctvGroup:
    type: object
    displayName: CCTV 그룹
    description: CCTV 그룹
    required: false
    properties:
      cctvGroupName:
        type: string
        description: CCTV 그룹명
        required: false
      regUser:
        type: string
        description: 등록자명
        required: false
      regDate:
        type: string
        description: 등록일자
        required: false
  cctv_group_id:
    type: cctvGroup
    displayName: CCTV 그룹
    description: CCTV 그룹
    required: false
    properties:
      cctvGroupId:
        type: string
        description: CCTV 그룹 아이디
        required: false
  cctv:
    type: object
    displayName: CCTV
    description: CCTV
    required: false
    properties:
      cctvGroupId:
        type: string
        description: CCTV 그룹 아이디
        required: false
      cctvId:
        type: string
        description: CCTV 아이디
        required: false
      cctvName:
        type: string
        description: CCTV명
        required: false
  group_mapp_id:
    type: cctv
    displayName: CCTV
    description: CCTV
    required: false
    properties:
      groupMappId:
        type: string
        description: CCTV 매핑 아이디 ( 자동 생성 )
        required: false
  coords:
      type: object
      displayName: 좌표
      description: 좌표
      required: false
      properties:
        longitude:
          type: number
          description: 경도
          required: false
        latitude:
          type: number
          description: 위도
          required: false
    cleancar_realtime:
      type: object
      displayName: 청소차량 실시간정보
      description: 청소차량 실시간정보
      required: false
      properties:
        vin:
          type: string
          description: 차량번호
          required: false
        tid:
          type: string
          description: 운행 아이디
          required: false
        avgspeed:
          type: number
          description: 평균속도
          required: false
        guname:
          type: string?
          description: 구 이름
          required: false
        vtype:
          type: string?
          description: 차량 타입
          required: false
        coords:
          type: coords?
          description: 좌표
          required: false
    cleancar_history:
      type: object
      displayName: 청소차량 실시간정보
      description: 청소차량 실시간정보
      required: false
      properties:
        telId:
          type: string
          description: 운행 아이디
          required: false
        vin:
          type: string
          description: 차량번호
          required: false
        vtype:
          type: string
          description: 차량 타입
          required: false
        guname:
          type: string
          description: 구 이름
          required: false
        avgspeed:
          type: number
          description: 평균속도
          required: false
        wtDist:
          type: number?
          description: 사용안함
          required: false
        wtAmt:
          type: number?
          description: 사용안함
          required: false
        routeLen:
          type: number?
          description: 사용안함
          required: false
        fld:
          type: string?
          description: 사용안함
          required: false
        comm:
          type: string
          description: 사용안함
          required: false
        cleanLen:
          type: number?
          description: 청소 거리
          required: false
        worktime:
          type: number?
          description: 청소 시간
          required: false
        shapeLength:
          type: number?
          description: 사용안함
          required: false
        coords:
          type: coords[]?
          description: 좌표 이력
          required: false
  report:
    type: object
    displayName: 보고서
    description: 보고서
    required: false
    properties:
      title:
        type: string
        description: 보고서 제목
        required: false
      content:
        type: string
        description: 보고서 내용
        required: false
      dptId:
        type: string
        description: 부서 아이디
        required: false
      regDate:
        type: string
        description: 등록일자
        required: false
      regUser:
        type: string
        description: 등록자
        required: false
      statEvetOutbSeqn:
         type: string
         description: 해당 이벤트 유니크 id (보고서 관리 화면에선 사용하지 않음)
         required: false
  report_id:
    type: report
    displayName: 보고서
    description: 보고서
    required: false
    properties:
      reportId:
        type: string
        description: 보고서 아이디
        required: false
  files:
    type: object
    displayName: 파일
    description: 파일
    required: false
    properties:
      fileName:
        type: string
        description: 파일 명
        required: false
      fileLoc:
        type: string
        description: 파일 경로
        required: false
  files_id:
    type: files
    displayName: 파일
    description: 파일
    required: false
    properties:
      reportFileMappId:
        type: string
        description: 파일 아이디 ( 자동 생성 )
        required: false
  dstrgroup:
    type: object
    displayName: 재난 그룹
    description: 재난 그룹
    required: false
    properties:
      dstrType:
        type: string
        description: 재난 유형 (S->사회 재난 , N->자연 재난)
        required: false
      dstrGroupName:
        type: string
        description: 재난 그룹 명
        required: false
      regDate:
        type: string
        description: 등록일자
        required: false
      regUser:
        type: string
        description: 등록자 명
        required: false
  dstr_group_id:
    type: dstrgroup
    displayName: 재난 그룹
    description: 재난 그룹
    required: false
    properties:
      dstrGroupId:
        type: string
        description: 재난 그룹 아이디 ( 자동 생성 )
        required: false
  dstrdpt:
    type: object
    displayName: 재난 부서
    description: 재난 부서
    required: false
    properties:
      dstrGroupId:
        type: string
        description: 재난 그룹 아이디 ( 자동 생성 )
        required: false
      dptId:
        type: string
        description: 부서 아이디
        required: false
      dptName:
        type: string
        description: 부서 명
        required: false
  dstr_dpt_mapp_id:
    type: dstrdpt
    displayName: 재난 부서
    description: 재난 부서
    required: false
    properties:
      dstrDptMappId:
        type: string
        description: 그룹 부서 맵핑 아이디 ( 자동 생성 )
        required: false
  dstrhistory:
    type: object
    displayName: 재난 이력
    description: 재난 이력
    required: false
    properties:
      dstrGroupId:
        type: string
        description: 재난 그룹 아이디
        required: false
      dstrHistTitle:
        type: string
        description: 재난 이력 명
        required: false
      dstrHistCont:
        type: string
        description: 재난 이력 내용
        required: false
      deadCount:
        type: string
        description: 사망 인원
        required: false
      injuredCount:
        type: string
        description: 부상 인원
        required: false
      missingCount:
        type: string
        description: 실종 인원
        required: false
      damageAmount:
        type: string
        description: 재산 피해
        required: false
      occurDate:
        type: string
        description: 재난 발생일
        required: false
      regDate:
        type: string
        description: 재난 이력 등록일
        required: false
      regUser:
        type: string
        description: 재난 이력 등록자
        required: false
  dstr_hist_id:
    type: dstrhistory
    displayName: 재난 이력
    description: 재난 이력
    required: false
    properties:
      dstrHistId:
        type: string
        description: 재난 이력 아이디 ( 자동 생성 )
        required: false
  dstrmanager:
    type: object
    displayName: 재난 이력 관리자
    description: 재난 이력 관리자
    required: false
    properties:
      dstrHistId:
        type: string
        description: 재난 이력 아이디 ( 자동 생성 )
        required: false
      managerContact:
        type: string
        description: 관리자 연락처
        required: false
      managerName:
        type: string
        description: 관리자 명
        required: false
      dptId:
        type: string
        description: 부서 아이디
        required: false
  manager_mapp_id:
    type: dstrmanager
    displayName: 재난 이력 관리자
    description: 재난 이력 관리자
    required: false
    properties:
      managerMappId:
        type: string
        description: 재난 이력 관리자 아이디 ( 자동 생성 )
        required: false
  dstrEvetHist:
    type: object
    displayName: 재난 상황 전파 이력
    description: 재난 상황 전파 이력
    required: false
    properties:
      title:
        type: string
        description: 재난 상황 전파 이력 제목
        required: false
      content:
        type: string
        description: 재난 상황 전파 이력 내용
        required: false
      propagationTarget:
        type: string
        description: 재난 상황 전파 이력 전파 대상
        required: false
      statEvetOutbSeqn:
        type: string
        description: 재난 상황 전파 이력 맵핑 이벤트 아이디
        required: false
      type:
        type: number
        description: 재난 상황 전파 이력 타입 (1=전파, 2=공유, 3=문자발생)
        required: false
  dstrEvetHist_id:
    type: dstrEvetHist
    displayName: 재난 상황 전파 이력
    description: 재난 상황 전파 이력
    required: false
    properties:
      dstrEvetHistId:
        type: string
        description: 재난 상황 전파 이력 아이디
        required: false
  dstrEvetFile:
    type: object
    displayName: 재난 상황 전파 첨부파일
    description: 재난 상황 전파 첨부파일
    required: false
    properties:
      dstrEvetHistId:
        type: string
        description: 재난 상황 전파 이력 아이디
        required: false
      fileName:
        type: string
        description: 파일 이름
        required: false
      fileLoc:
        type: string
        description: 파일 위치
        required: false
  dstrEvetFile_id:
    type: dstrEvetFile
    displayName: 재난 상황 전파 첨부파일
    description: 재난 상황 전파 첨부파일
    required: false
    properties:
      dstrEvetHistFileMappId:
        type: string
        description: 재난 상황 전파 첨부파일 아이디
        required: false
  dstrEvetCctv:
    type: object
    displayName: 재난 상황 전파 CCTV
    description: 재난 상황 전파 CCTV
    required: false
    properties:
      dstrEvetHistId:
        type: string
        description: 재난 상황 전파 이력 아이디
        required: false
      cctvId:
        type: string
        description: CCTV 아이디
        required: false
      cctvName:
        type: string
        description: CCTV 이름
        required: false
  dstrEvetCctv_id:
    type: dstrEvetCctv
    displayName: 재난 상황 전파 CCTV
    description: 재난 상황 전파 CCTV
    required: false
    properties:
      dstrEvetHistFileMappId:
        type: string
        description: 재난 상황 전파 CCTV 아이디
        required: false

#주요구역
/mainareas:
  description: 주요구역
  get:
    description: 주요구역 목록 조회
    responses:
      200:
        description: 정상적으로 주요구역 목록이 요청됐을 경우
        body:
          application/json:
            type: mainarea_id[]
            example: !include ../raml/example/mainarea/get_mainArea_list.json
  post:
      description: 주요구역 등록
      queryParameters:
        mainAreaName:
          type: string
          description: 주요구역 이름
          required: true
          example: "구월동001"
        mainAreaGeojson:
          type: string
          description: 주요구역 도형 데이터
          required: true
          example: "GeoJson Data"
        regUser:
          type: string
          description: 주요구역 등록자 명
          required: true
          example: "choiyk"
        regDate:
          type: string
          description: 주요구역 등록일자
          required: true
          example: "202010071626123"
      body:
        application/json:
          type: mainarea
      responses:
        201:
          description: 정상적으로 주요구역이 등록됐을 경우
          headers:
            Content-Location:
              description: 생성된 주요구역 데이터 요청 url
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: 주요구역 등록 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
  /{mainAreaId}:
    uriParameters:
      mainAreaId:
        type: string
        description: 주요구역 아이디
        example: "mainarea_8EZPIl9qAI39GsXUyMSFY-"
    put:
      description: 주요구역 수정(전체 수정)
      queryParameters:
        mainAreaName:
          type: string
          description: 주요구역 이름
          required: true
          example: "구월동001"
        mainAreaGeojson:
          type: string
          description: 주요구역 도형 데이터
          required: true
          example: "GeoJson Data"
        regUser:
          type: string
          description: 주요구역 등록자명
          required: true
          example: "choiyk"
        regDate:
          type: string
          description: 주요구역 등록일자
          required: true
          example: "202010071626123"
      body:
        application/json:
          type: mainarea
      responses:
        200:
          description: 정상적으로 주요구역이 수정됐을 경우
          headers:
            Content-Location:
              description: 생성된 주요구역 데이터 요청 url
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: 주요구역 수정 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
    patch:
      description: 주요구역 수정(부분 수정)
      queryParameters:
        ainAreaName:
         type: string
         description: 주요구역 이름
         required: true
         example: "구월동001"
        ainAreaGeojson:
         type: string
         description: 주요구역 도형 데이터
         required: true
         example: "GeoJson Data"
        egUser:
         type: string
         description: 주요구역 등록자 명
         required: true
         example: "choiyk"
        egDate:
         type: string
         description: 주요구역 등록일자
         required: true
         example: "202010071626123"
      body:
        application/json:
          type: mainarea
      responses:
        200:
          description: 정상적으로 주요구역이 수정됐을 경우
          headers:
            Content-Location:
              description: 생성된 주요구역 데이터 요청 url
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: 주요구역 수정 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
    get:
      description: 주요구역 단건 조회
      responses:
        200:
          description: 정상적으로 주요구역 단건이 요청됐을 경우
          body:
            application/json:
              type: mainarea_id
              example: !include ../raml/example/mainarea/get_mainArea.json
    delete:
      description: 주요구역 삭제
      responses:
        200:
          description: 정상적으로 주요구역이 삭제됐을 경우
          body:
            application/json:
              properties:
                message:
                  description: 주요구역 삭제 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
################################################################
#CCTV 그룹
/mycctvgroup:
  description: CCTV 그룹
  get:
    description: CCTV 그룹 목록
    responses:
      200:
        description: 정상적으로 CCTV 그룹 목록이 요청됐을 경우
        body:
          application/json:
            type: cctv_group_id[]
            example: !include example/cctvgroup/get_cctv_group_list.json
  post:
      description: CCTV 그룹 등록
      queryParameters:
        cctvGroupName:
          type: string
          description: CCTV 그룹명
          required: true
          example: "구월동"
        regUser:
          type: string
          description: 등록자
          required: true
          example: "choiyk"
        regDate:
          type: string
          description: 등록 일자
          required: true
          example: "20201007153030358"
      body:
        application/json:
          type: cctvGroup
      responses:
        201:
          description: 정상적으로 CCTV 그룹이 등록됐을 경우
          headers:
            Content-Location:
              description: 생성된 주요구역 데이터 요청 url
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: CCTV 그룹 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
  /{cctvGroupId}:
    uriParameters:
      cctvGroupId:
        type: string
        description: CCTV 그룹 아이디
        example: "cctvGroup_ZEXUAsnA5YaCP2Zxehzyv"
    put:
      description: CCTV 그룹 수정(전체 수정)
      queryParameters:
        cctvGroupName:
          type: string
          description: CCTV 그룹명
          required: true
          example: "관교동"
        regUser:
          type: string
          description: 등록자
          required: true
