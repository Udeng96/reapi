################################################################

#보고서
/reports:
  description: 보고서
  get:
      description: 보고서 목록 조회
      queryParameters:
        token:
          type: string
          description: OMS에서 제공하는 사용자 토큰
          required: true
          example: "eikCeqKOQWPa0KZwLh8Tii"
        statEvetOutbSeqn:
          type: string
          description: 재난 상황 전파 이력 맵핑 이벤트 아이디
          required: true
          example: "E_510YdH21kFib~vYiBlSnrb"
      responses:
        200:
          description: 정상적으로 보고서 목록이 요청됐을 경우
          body:
            application/json:
              type: report_id[]
              example: !include ../raml/example/report/get_report_list.json
  post:
      description: 보고서 등록
      body:
        application/json:
          type: report
      responses:
        201:
          description: 정상적으로 보고서가 등록됐을 경우
          headers:
            Content-Location:
              description: 생성된 경로 데이터 요청 url (reportId 포함 되어있음)
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: 보고서 등록 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
  /{reportId}:
    uriParameters:
      reportId:
       type: string
       description: 보고서 아이디
       example: "report_6usZO3IXkl68HzEhLZd-RZ"
    put:
      description: 보고서 수정(전체 수정)
      body:
        application/json:
          type: report
      responses:
        200:
          description: 정상적으로 보고서가 수정됐을 경우
          headers:
            Content-Location:
              description: 생성된 보고서 데이터 요청 url
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: 보고서 수정 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
    patch:
      description: 보고서 수정(부분 수정)
      body:
        application/json:
          type: report
      responses:
        200:
          description: 정상적으로 보고서가 수정됐을 경우
          headers:
            Content-Location:
              description: 생성된 경로 데이터 요청 url
              displayName: ContentLocation
              type: string
              required: false
          body:
            application/json:
              properties:
                message:
                  description: 보고서 수정 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
    get:
      description: 보고서 단건 조회
      responses:
        200:
          description: 정상적으로 보고서 단건이 요청됐을 경우
          body:
            application/json:
              type: report_id
              example: !include ../raml/example/report/get_report.json
    delete:
      description: 보고서 삭제
      responses:
        200:
          description: 정상적으로 보고서가 삭제됐을 경우
          body:
            application/json:
              properties:
                message:
                  description: 보고서 삭제 결과 메세지
                  type: string
                  required: false
                  example: !include ../raml/example/common/message_success.json
#파일
    /files:
      get:
        description: 파일 목록 조회
        responses:
          200:
            description: 정상적으로 파일 목록이 요청됐을 경우
            body:
              application/json:
                type: files[]
                example: !include ../raml/example/file/get_file_list.json
      post:
          description: 파일 등록
          body:
            multipart/form-data:
              properties:
                fileData:
                  type: file
                  description: 첨부 파일(MultipartFile)
                  required: false
                  example: include Some File
          responses:
            201:
              description: 정상적으로 파일이 등록됐을 경우
              headers:
                Content-Location:
                  description: 생성된 파일 데이터 요청 url
                  displayName: ContentLocation
                  type: string
                  required: false
              body:
                application/json:
                  properties:
                    message:
                      description: 파일 등록 결과 메세지
                      type: string
                      required: false
                      example: !include ../raml/example/common/message_success.json
      /{reportFileMappId}:
        uriParameters:
          reportFileMappId:
           type: string
           description: 파일 아이디
           example: "file_4arNfkF-Q2zalP9FED~zEb"
        put:
          description: 파일 수정(전체 수정)
          body:
            application/json:
              type: file
          responses:
            200:
              description: 정상적으로 파일이 수정됐을 경우
              headers:
                Content-Location:
                  description: 생성된 파일 데이터 요청 url
                  displayName: ContentLocation
                  type: string
                  required: false
              body:
                application/json:
                  properties:
                    message:
                      description: 파일 수정 결과 메세지
                      type: string
                      required: false
                      example: !include ../raml/example/common/message_success.json
        patch:
          description: 파일 수정(부분 수정)
          body:
            application/json:
              type: file
          responses:
            200:
              description: 정상적으로 파일이 수정됐을 경우
              headers:
                Content-Location:
                  description: 생성된 파일 데이터 요청 url
                  displayName: ContentLocation
                  type: string
                  required: false
              body:
                application/json:
                  properties:
                    message:
                      description: 파일 수정 결과 메세지
                      type: string
                      required: false
                      example: !include ../raml/example/common/message_success.json
        get:
          description: 파일 단건 조회
          responses:
            200:
              description: 정상적으로 파일 단건이 요청됐을 경우
              body:
                application/json:
                  type: files_id
                  example: !include ../raml/example/file/get_file.json
        delete:
          description: 파일 삭제
          responses:
            200:
              description: 정상적으로 파일이 삭제됐을 경우
              body:
                application/json:
                  properties:
                    message:
                      description: 파일 삭제 결과 메세지
                      type: string
                      required: false
                      example: !include ../raml/example/common/message_success.json
        /download:
          description: 파일 다운로드
          get:
            description: 파일 다운로드
            responses:
              200:
                body:
                  multipart/form-data:
                    type: file (MultipartFile fileData)
                    example: Download Some File
#경로
/routes:
  description: 경로
  get:
    description: 경로 목록 조회
    responses:
      200:
        description: 정상적으로 경로 목록이 요청됐을 경우
        body:
          application/json:
            type: route_id[]
            example: !include ../raml/example/route/get_route_list.json
  post:
      description: 경로 등록
      queryParameters:
        routeName:
          type: string
          description: 경로 명
          required: true
          example: "구월_산책로"
        regUser:
          type: string
          description: 등록자 명
          required: true
          example: "choiyk"
        regDate:
          type: string
          description: 등록일자
          required: true
          example: "202010071641123"
      body:
        application/json:
          type: route
      responses:
        201:
          description: 정상적으로 경로가 등록됐을 경우
