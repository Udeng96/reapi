#%RAML 1.0
title: 저수지 API
version: 1.0
protocols: [HTTP]
mediaType: application/json
baseUri: http://{domain}:{port}/api
baseUriParameters:
  domain:
    type : string
    description: API 서버가 설치된 도메인
  port:
    type : integer
    description: API 서버 접속 포트(80인 경우 생략)
description: 화진데이터를 연계하여 response 하는 api
            <br>
            stat 요청에 page(default =1), rows(default=10) 파라미터가 추가되었습니다.
            <br>
types:
  gisInfo:
    type: object
    description: 공통 시설물 정보 (gis가 사용되는 모든 곳에 출력하는 object)
    properties:
      facId:
        type : string
        description: 시설물 id
      facNm :
        type : string
        description: 시설물 명칭
      addr:
        type: string
        description: 시설물 주소정보
      lat :
        type : number
        description: 위도
      lng :
        type : number
        description: 경도
      type:
        type: string
        description: 시설물 타입 / 혹은 구분 코드(분류코드로 활용할 예정)
      useYn:
        type : boolean
        description: 사용유무
      state:
        type : string
        description: ON - 정상, OFF - 종료, ERROR - 비정상 이후 필요한 상태에 대해 정의 후 사용 바람
      updDtm:
        type : string
        description: 장비 혹은 센서의 업데이트 시각이 필요한 경우 사용 (form - yyyyMMDDHHmmSS)
        required: false
      data:
        type : object | nil
        description: 시설물 별로 데이터를 함께 가져가야하는 경우 사용
        required: false
  stat:
    type : object
    description: 저수지 타입
    properties:
      date:
        type: string
        description: 통계 시각
      val:
        type: number
        description: 통계 값
  statInfo:
    type: object
    description: 통계 정보
    properties:
      fac :
        type : gisInfo
        description: 통계정보에 물리는 값
      data:
        type : stat[]
        description: 통계 정보

/fac:
  description: 시설물
  /reservoir:
    description: 저수지 API
    get:
      description: 저수지 계측기 정보요청
      responses:
        200:
          body:
            application/json:
              type : gisInfo[]
              example: !include ../../example/gg/fac/reservoir/reservoirList.json
    /stat:
      description: 저수지 통계 정보 요청
      get:
        description: 저수지 전체 리스트
        queryParameters:
          startDtm :
            type : string
            description: 조회 시작 일자 format-yyyyMMdd
            required: false
            default: 20220304 (금일날짜로 조회)
          endDtm :
            type : string
            description: 조회 종료일자 format-yyyyMMdd
            required: false
            default: 20220304 (금일날짜로 조회)
          dataType:
            type : string
            description: 연간(Y), 월간(M), 일간(D) , 시간 (H) , 10분단위(M)
            required: true
            default: M
          row:
            type: number
            description: 데이터 갯수 지정
            required: false
          page:
            type: number
            description: 요청 페이지 넘버, -1로 요청시 전체 조회
            required: false
            default: 1
          rows:
            type: number
            description: 한페이징 표출 row 수
            required: false
            default: 10
        responses:
          200:
            body:
              applcation/json :
                type : statInfo[]
                example : !include ../../example/gg/fac/reservoir/statInfoList.json
    /{areaCd}:
      uriParameters:
        areaCd:
          type : string
          description: 화진에서 구별하는 지역구 정보
          example: "572"
      get:
        description: 저수지 계측기 개별 정보 요청
        responses:
          200:
            body:
              application/json:
                type: gisInfo
                example: !include ../../example/gg/fac/reservoir/reservoir.json
      /stat:
        get:
          description: 저수지 통계 개별 요청 일반
          queryParameters:
            startDtm :
              type : string
              description: 조회 시작 일자 format-yyyyMMdd
              required: false
              default: 20220304 (금일날짜로 조회)
            endDtm :
              type : string
              description: 조회 종료일자 format-yyyyMMdd
              required: false
              default: 20220304 (금일날짜로 조회)
            dataType:
              type : string
              description: 연간(Y), 월간(M), 일간(D) , 시간 (H) , 10분단위(M)
              required: true
              default: M
            row:
              type: number
              description: 데이터 갯수 지정
              required: false
          responses:
            200:
              body :
                application/json:
                  type : statInfo
                  example: !include ../../example/gg/fac/reservoir/statInfo.json