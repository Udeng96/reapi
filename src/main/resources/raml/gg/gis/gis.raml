/myCctvGroup:
  description: 내 CCTV 그룹 설정 //2022.04.26 수정요청으로 인하여, cctvs 삭제 및 병합
  post:
    description: 내 CCTV 그룹 등록/등록후 reponse 받은 id 값으로 맵핑 정보 등록
    body:
      application/json:
        type : object
        example : |
          {
            "cctvGroupNm" : "그룹명칭",
            "userId" : "작성자 식별값",
            "cctvs" : [
              {
                "cctvId" : "cctv 식별값",
                "cctvNm" : "cctv 명칭",
                "lat" : 37.002,
                "lng": 128.00002
              }
            ]
          }
    responses:
      200:
        description: 정상요청 결과가 나옵니다. 결과로 id 값이 나오지만 이제 사용하지않아도됩니다.
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_post_success.json
      400:
        description: 요청 파라미터가 잘못된 경우
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_400.json
      401:
        description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      500:
        description: 서버에러
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_500.json
  get:
    description: 내 CCTV 그룹 목록 조회
    queryParameters:
      userId:
        type : string
        description: 사용자 식별값
        required: true
    responses:
      200:
        description: 정상 요청의 response
        body:
          application/json:
            type: myCctvGroupInfo[]
            example: !include ../../example/gg/gis/myCctvGroup/myCctvGroupList.json
      400:
        description: 요청 파라미터가 잘못된 경우
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_400.json
      401:
        description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      500:
        description: 서버에러
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_500.json
  /{myCctvGroupId}:
    get:
      description: 내 CCTV 그룹 개별 조회
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: myCctvGroupInfo
              example: !include ../../example/gg/gis/myCctvGroup/myCctvGroup.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
    put:
      description: 내 CCTV 그룹 개별 수정 / mapping 정보 수정 X
      queryParameters:
        cctvGroupNm:
          type : string
          description: 그룹명칭
      body:
        application/json:
          type: groupCctv[]
          example : |
            [
              {
                "cctvId" : "cctv식별값",
                "cctvNm" : "cctv 명칭",
                "lat":37.5,
                "lng" : 128.00
              },
              {
                "cctvId" : "cctv식별값",
                "cctvNm" : "cctv 명칭",
                "lat":37.5,
                "lng" : 128.00
              }
            ]
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_200.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
    delete:
      description: 내 CCTV 그룹 개별 삭제 / 하위 맵핑정보까지 삭제
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_200.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
