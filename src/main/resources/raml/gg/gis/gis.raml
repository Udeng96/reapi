        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
  /type:
    description: 이벤트 종류 정보 호출 api, 이벤트 검색 화면에서 이벤트 종류의 정보입니다.
    get:
      description: 접속자의 권한에 해당하는 이벤트 타입 목록 출력, 소방과, 일반 모두 이 api를 사용합니다.
      queryParameters:
