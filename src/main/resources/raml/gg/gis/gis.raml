/event:
  description: 접속자의 권한에 해당하는 이벤트를 출력합니다, 각 api 별사용 화면이 다릅니다
  get:
    description: 이벤트 조회(검색조건에 맞는) , 이벤트 조회 부분에서 사용합니다.
    headers:
      token:
        type: string
        description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
        required: true
    queryParameters:
      isFire:
        type: boolean
        description: 소방 이벤트 여부
        required: true
      evetIdList:
        type : string[]
        description: 필터 이벤트 종류 리스트
        required: false
      locationCdList:
        type: string[]
        description: 필터 지자체 리스트
        required: false
      startDtm :
        type : string
        description: 검색 시작일자 , dateformat yyyyMMdd
        required: false
      endDtm:
        type: string
        description: 검색 종료일자, date format yyyyMMdd
        required: false
      page:
        type: number
        description: 페이징 요청 값, 만약 -1로 요청하는경우 row 값을 무시하고 전체 결과를 반환합니다.
        required: false
      rows:
        type : number
        description: 페이징 요청 값
        required: false
    responses:
      200 :
        body:
          application/json:
            type: event[]
            example: !include ../../example/gg/gis/event/eventList.json
      401:
        description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      400:
        description: 요청 파라미터가 잘못된 경우
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_400.json
      500:
        description: 서버에러
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_500.json
  /{eventSeqn}:
    description: 이벤트 단건에 대한 api
    uriParameters:
      eventSeqn:
        type: string
        description: 이벤트 식별값
    get:
      description: 이벤트 단건 조회, 이벤트 검색에서 상세보기에 사용합니다.
      responses:
        200:
          body:
            application/json:
              type: event
              example: !include ../../example/gg/gis/event/event.json
        401:
          description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
