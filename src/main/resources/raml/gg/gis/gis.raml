#%RAML 1.0
title: GIS API Document
version: 1.3
protocols: [HTTP]
mediaType: application/json
baseUri: http://{domain}:{port}/api
baseUriParameters:
  domain:
    type : string
    description: API 서버가 설치된 도메인
  port:
    type : integer
    description: API 서버 접속 포트
description: 경기도청 gis 상황판 api 문서
  <br>
  접근한 사용자의 권한에 따라 표출 및 검색되는 정보가 달라집니다
  <br>
  플랫폼, 운영사 관리자는 모든 gis상황판의 모든 기능을 사용할 수 있으나
  <br>
  현장, 일반 사용자는 시설물 등록 기능 불가
  <hr>
  <h2>전달 내역이 있는경우 아래와 같이 기재하여 전달토록하겠습니다. raml 버전 변경에 따라 기존의 내용은 사라질 수 있습니다.</h2>
  <br>
  <br>
  <dl>
      <dt>소방 이벤트</dt>
      <dd>소방 이벤트 클릭시 출동차량 번호와 vms 관리번호를 호출하는 호출 API는 현재 개발은 완료되었습니다.</dd>
      <hr/>

      <dt>CCTV</dt>
      <dd>CCTV 분류 및 시설물은 fms에 등록하여 사용하지않기때문에, 분류그룹에 따른 icon을 대시보드 단에서 지정해서 사용해주셔야합니다.</dd>
      <hr/>

      <dt><h3>CCTV 그룹설정 20220426 수정</h3></dt>
      <dd>route 변경요청과 동일하게 변경 완료했습니다만. cctv 좌표 체계가 숫자형식으로 만들어져있습니다.route는 string myCctvGroup은 number 입니다.</dd>
      <hr/>

      <dt>사용자 지정경로</dt>
      <dd>기존 locations로 하위까지 컨트롤하게 되었던 부분을 간략화 및 통합을 진행하였습니다.</dd>
      <hr/>

      <dt>시설물관리(운영사, 플랫폼 관리자만 사용가능 기능)</dt>
      <dd>FMS와 연계되는 관리 화면입니다. 먼저 분류 그룹 리스트에서 표출 icon은 normal icon을 표출하시면됩니다.</dd>
      <dd>시설물 등록시, 지도를 클릭하고, 분류 그룹을 지정할수 있어야합니다 이때 좌표 별로 권한별로 지정등록할수 있는 것을 조회(/byPos/fac/clfy fetch)하고, 미분류를 최상단으로 해주셔야합니다.
          또한, 좌표도 마찬기지로 정보조회(/byPos/posNm) 후 나온 결과값을 사용해주셔야합니다.
      </dd>
      <hr/>

      <dt>지도설정</dt>
      <dd>CCTV 분류는 cctv/clfy를 사용해주시면되고, icon 또한 지정된것을 사용하시면됩니다.</dd>
      <dd>
        시설물 부분에 여러가지를 띄워야합니다.<br>
        먼저 화진 시설물을 경기도청 시설물(가칭)이라는 뎁쓰로 표출해야하며,
        fms 연동 사용자 지정등록(가칭)으로 지역구 별 시설물분류를 트리구조를 표출해주시고,
        배수펌프, 재난예경보 각각의 fix된(하드코딩이라고 볼수 있습니다)를 각각 컨트롤하게 되어야합니다.
     </dd>
      <hr/>
  </dl>


types:
  message:
    type: object
    description: 요청 결과 메세지 주로 400, 401, 404, 500, 수정,등록,삭제에 대한 요청의 respose에 사용
    properties:
      message:
        type: string
        description: 요청 결과 메세지
  regFac:
    type: object
    description: 시설물 등록 json type
    properties:
      facNm:
        type: string
        description: 변경 시설물 명칭
        required: true
      clfyCd:
        type: string
        description: 시설물 분류 id
        required: true
      addr:
        type: string
        description: 시설물 위치 주소
        required: true
      lat:
        type: number
        description: 위도
      lng:
        type: number
        description: 경도
  groupCctv:
    type : object
    description: 그룹에 속한 cctv
    properties:
      cctvId:
        type : string
        description: cctv id
      cctvNm:
        type : string
        description: cctv 명칭
      lat:
        type : number
        description: 위도
      lng:
        type : number
        description: 경도
  findClfy:
    type : object
    description: 시설물 분류
    properties:
      id:
        type : string
        description: 시설물 분류 식별값
      nm:
        type : string
        description: 시설물 분류 명칭
  gisInfo:
    type: object
    description: cctv
    properties:
      facId:
        type: string
        description: 시설물 식별값
      facNm:
        type : string
        description: 시설물 명칭
      addr :
        type : string
        description: 주소
      lat:
        type : number
        description: 위도
      lng:
        type : number
        description: 경도
      clfyCd :
        type : string
        description: 시설물 그룹코드
      clfyNm:
        type : string
        description: 시설물 그룹명칭
      useYn:
        type: boolean
        description: 사용유무
      state:
        type : string
        description: ON - 정상, OFF - 종료, ERROR - 비정상 이후 필요한 상태에 대해 정의 후 사용 바람
      updDtm:
        type: string
        description: 최근 업데이트 일자
      data:
        type : object | nil
        description: 추가 정보
      locationCd:
        type : string
        description: 지자체 코드
      locationNm :
        type : string
        description: 지자체 명칭
  facClfy:
    type : clfyInfo
    description: 시설물(fms에 등록된)
    properties:
      gisNormalIconUrl:
        type : string
        description: gis icon 기본 url
      gisHoverIconUrl:
        type: string
        description: gis icon 마우스 오버 url
      gisActiveIconUrl:
        type: string
        description: gis icon 클릭 url
      regDtm:
        type: string
        description: 등록일자
      facCount:
        type: number
        description: 하위 시설물 수
  clfyInfo:
    type : object
    description: 시설물 분류 값
    properties:
      id:
        type : string
        description: 분류 식별값
      nm:
        type: string
        description: 분류 명칭
  clfyInfoWithIcon:
    type: clfyInfo
    properties:
      gisNormalIconUrl:
        type : string
        description: gis icon 기본 url
      gisHoverIconUrl:
        type: string
        description: gis icon 마우스 오버 url
      gisActiveIconUrl:
        type: string
        description: gis icon 클릭 url
  event:
    type: object
    description: 이벤트 정보
    properties:
      statEvetOutbSeqn :
        type : string
        description: 이벤트 식별값
      eventId:
        type : string
        description: 이벤트 종류 구분 코드, client, site 코드 값이 제외된 값
      eventNm:
        type: string
        description: 이벤트 종류 명칭
      locationCd:
        type: string
        description: 지자체 구분코드 (siteCd)
      locationNm:
        type : string
        description: 지자체 명칭(siteNm)
      lat :
        type: number
        description: 위도
      lng:
        type : number
        description: 경도
      addr :
        type : string
        description: 이벤트 방생 주소
      cntn :
        type : string
        description: 이벤트 내용
      outbDtm :
        type : string
        description: 이벤트 발생 일자정보 dataFormat(yyyyMMddHHmmss)
      clsDtm :
        type : string
        description: 이벤트 종료 일자정보 dataFormat(yyyyMMddHHmmss)
  clfyAll:
    type : object
    description: 지자체에 물린 시설물 분류까지 표출하는 type
    properties:
      locationCd:
        type: string
        description: 지자체 구분 코드
      locationNm :
        type : string
        description: 지자체 구분 명칭
      id:
        type: string | nil
        description: 디비에서 조회할때 사용하는 값으로 프론트에서 사용하지않음
      nm:
        type: string | nil
        description: 디비에서 조회할때 사용하는 값으로 프론트에서 사용하지않음
      gisNormalIconUrl:
        type: string |nil
        description: 디비에서 조회할때 사용하는 값으로 프론트에서 사용하지않음
      gisHoverIconUrl:
        type: string |nil
        description: 디비에서 조회할때 사용하는 값으로 프론트에서 사용하지않음
      gisActiveIconUrl:
        type: string |nil
        description: 디비에서 조회할때 사용하는 값으로 프론트에서 사용하지않음
      clfyList:
        type : clfyInfoWithIcon[]
        description: 시설물 분류 그룹리스트
  userInfo:
    type : object
    description: 유저정보
    properties:
      result:
        type : string
        description: 요청 성공 메세지
      data:
        type : object
        description: 사용자 정보를 담고 있는 obj
        properties:
          token:
            type : string
            description: 사용자 토큰 정보
          userId:
            type : string
            description: userID
          userName:
            type: string
            description: 유저명
          loginId:
            type : string
            description: 접속 로그인 id
          mobile :
            type: string
            description: 휴대전화번호
          phone :
            type : string
            description: 전화번호
          email:
            type: string
            description: 이메일 정보
          grupId:
            type : string
            description: 부서정보/gis 상황판에서 사용하지않음
          orgnId:
            type : string
            description: 부서정보/gis 상황판에서 사용하지않음
          dptId:
            type : string
            description: 부서정보/gis 상황판에서 사용하지않음
          userGd:
            type : string
            description: 유저 타입 정보!! 001 - 플랫폼 계정, 002 - 운영사 계정 , 003 - 현장 계정, 004 - 일반 계정
          clientCd:
            type : string
            description: 계정 생성시 부여된 client code
          siteCd:
            type: string
            description: 계정 생성시 부여된 site code
          dptInfo:
            type : object
            description: 룰권한 정보 / 사용 X
          clientInfo:
            type : object[]
            description: 권한이 부여된 운영사 정보 / 사용 X
          siteList:
            type: siteInfo[]
            description: 권한이있는 site 목록
  siteInfo:
    type: object
    description: 허용 지자체 정보
    properties:
      siteCd:
        type : string
        description: 지자체 코드로 사용 locationCd와 동일
      clientCd:
        type: string
        description: 운영사 코드
      siteInfo:
        type: string | nil
        description: 빈값
      siteNm:
        type : string
        description: 지자체 명으로 사용 locationNm와 동일
      creDtm:
        type: string
        description: 생성일자
      creMn:
        type : string
        description: 생성자
      expDtm:
        type : string
        description:
      rotation:
        type : string
        description:
      accidentOccurredDtm:
        type : string
        description:
      siteDisplayNm:
        type : string
        description:
  routeInfo:
    type: object
    displayName: 경로
    description: 경로
    properties:
      routeId:
        type : string
        description: 경로 식별값
        required: false
      routeNm:
        type: string
        description: 경로명
        required: false
      maintenanceTime:
        type: number
        description: 지점 유지 시간
        required: false
      userId:
        type: string
        description: 등록자 식별값
        required: false
      userNm:
        type: string
        description: 등록자명
        required: false
      regDtm:
        type: string
        description: 등록일자 date format yyyyMMddHHmmss
        required: false
      locations:
        type : routeLocation[]
        description: 사용자 지정 경로에 물리는 지역 리스트
  routeLocation:
    type: object
    description: 위치
    properties:
      locId:
        type: string | nil
        description: 경로 위치 id
        required: false
      routeId:
        type: string | nil
        description: 경로 아이디
        required: false
      lon:
        type: string
        description: 경도
        required: true
      lat:
        type: string
        description: 위도
        required: true
      addr:
        type: string
        description: 주소
        required: true
      index:
        type : number
        description: 순서
        required: true
#  loc_id:
#    type: routeLocation
#    displayName: 위치
#    description: 위치
#    properties:
#      locId:
#        type: string
#        description: 위치 아이디
  myCctvGroupInfo:
    type: object
    description: 내 cctv 그룹 정보
    properties:
      myCctvGroupId:
        type: string
        description: 식별값
      myCctvGroupNm:
        type: string
        description: 명칭
      regDtm:
        type : string
        description: 등록일자 date format yyyyMMddHHmmss
      userId:
        type : string
        description: 사용자 식별값
      userNm:
        type: string
        description: 등록자 명칭
      cctvs:
        type : groupCctv[]
  myCctvGroupMapp:
    type: groupCctv
    description: 내 cctv 그룹 맵핑 cctv 정보
    properties:
      myCctvGroupCctvMappId:
        type : string
        description: 맵핑 id 값
      myCctvGroupId:
        type : string
        description: 내 cctv 그룹 id
  findLatLng:
    type : object
    description: 주소로 검색한 좌표 정보
    properties:
      lat:
        type: number
        description: 위도
      lng :
        type: number
        description: 경도
      addr:
        type: string
        description: 주소
  #  findAddr:
  #    type: object
  #    description: 주소찾기 정보
  #    properties:
  #      category:
  #        type: string | nil
  #        description: 빈문자열 혹은 사용하지않는 값
  #      highlighted:
  #        type: number[][]
  #        description: 사용하지않는 값
  findAddr:
    type: object
    description: 주소 검색 정보
    properties:
      id :
        type: string
        description: vwolrd 식별값
      title:
        type : string
        description: 검색 키워드
      category:
        type: string
        description: 주소 카테고리
      address:
        type : object
        properties:
          road:
            type: string
            description: 도로명 주소
          parcel:
            type: string
            description: 지번 주소
      point :
        type: object
        description: 좌표 정보
        properties:
          x:
            type : string
            description: 경도
          y :
            type : string
            description: 위도
  eventClfy:
    type: object
    description: 이벤트 분류(히트맵에서 사용)
    properties:
      svcThemeCd:
        type: string
        description: 테마코드
      svcThemeNm:
        type: string
        description: 테마명
      itemList:
        type: eventClfyItem[]
        description: 하위 유닛 리스트
  eventClfyItem:
    type: object
    description: 유닛단위 이벤트
    properties:
      unitCd:
        type: string
        description: 유닛코드
      unitNm:
        type: string
        description: 유닛명
  heatmapEvent:
    type: object
    description: 이벤트 카운트
    properties:
      lat :
        type: number
        description: 위도
      lng :
        type: number
        description: 경도
      count:
        type: number
        description: 발생 이벤트 수
  searchConfig:
    type: object
    description: 검색 조건 정보
    properties:
      isFire:
        type: boolean
        description: 소방인지 구분
      clfy:
        type: string
        description: 이벤트 종류 리스트 string 값으로 stringify 하여 처리
      location:
        type: string
        description: 지자체 리스트 string 값으로 stringify 하여 처리
  drainPump:
    type: object
    description: 배수펌프 정보
    properties:
      sigunNm:
        type: string
        description: 시군명
      sigunCd:
        type: string
        description: 시군코드
      facltNm:
        type: string
        description: 시설명
      instlDe:
        type: string
        description: 설치일자
      instlPurps:
        type: string
        description: 설치목적
      mtrPumpScalDtls:
        type: string
        description: 모터펌프규모(kW(HP))
      mtrPumpCntInfo:
        type: string
        description: 모터펌프대수(대)
      engPumpScalDtls:
        type: string
        description: 엔진펌프규모(kW(HP))
      engPumpCnt:
        type: string
        description: 엔진펌프대수(대)
      kelepowSuplyMethd:
        type: string
        description: 한전전원공급방식(1회선 또는 2회선)
      emrGenorInfo:
        type: string
        description: 비상발전기(kW(HP))
      emrGenorCnt:
        type: string
        description: 비상발전기대수(대)
      kelepowConSuplyInfo:
        type: string
        description: 한전계약전력(kW, 고압/저압)
      useElecpwrInfo:
        type: string
        description: 사용전력량(kWH)/년 (최대/최소,고압/저압)
      elctyChrgInfo:
        type: string
        description: 전기요금(원)/년 (최대/최소,고압/저압)
      refineLotnoAddr:
        type: string
        description: 소재지지번주소
      refineRoadnmAddr:
        type: string
        description: 소재지도로명주소
      refineZipCd:
        type: string
        description: 소재지우편번호
      refineWgs84Logt:
        type: string
        description: WGS84경도
      refineWgs84Lat:
        type: string
        description: WGS84위도
  disasterEquipmentInfo:
    type: object
    description: 재난예경보 장비 정보
    properties:
      seq:
        type: number
        description: 장비 식별키
      equipCode:
        type: string
        description: 장비코드
      equipName:
        type: string
        description: 장비명
      sensorCode:
        type: number
        description: 센서코드
      sensorName:
        type: string
        description: 센서명
