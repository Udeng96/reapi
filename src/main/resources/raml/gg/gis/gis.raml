  /clfy:
    description: 시설물 그룹 분류 api, 시설물관리 화면에서 사용하는 API입니다. 화면에서 리스트의 item을 클릭하는경우 clfy/{clfyId}/facInfo로 호출하여 정보를 받아가야합니다.
    get:
      description: 시설물 그룹 분류 리스트 출력, 목록을 표출하고 , icon은 gisNormalIconUrl 을 표출합니다!
      headers:
        token:
          type: string
          description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
          required: true
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: facClfy[]
              example: !include ../../example/gg/gis/cctv/clfyList.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
    /{clfyCd}:
      uriParameters:
        clfyCd:
          type : string
          description: 시설물 분류 그룹 코드값
      get:
        description: 시설물 분류 그룹 개별 조회
        headers:
          token:
            type: string
            description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
            required: true
        responses:
          200:
            description: 정상 요청의 response
            body:
              application/json:
                type: facClfy
                example: !include ../../example/gg/gis/cctv/clfy.json
          400:
            description: 요청 파라미터가 잘못된 경우
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_400.json
          401:
            description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_401.json
          500:
            description: 서버에러
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_500.json
      post:
        description: 시설물 분류 업데이트, 추가된것은 해당 시설물 분류로 변경이 되고, 기존 시설물에서 빠진 시설물은 미분류가 됩니다.
        headers:
          token:
            type: string
            description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
            required: true
        body:
          application/json:
            type: gisInfo[]
            example: |
              [
                {
                  "facId": "테스트 시설물 id2",
                  "facNm": "테스트 시설물2",
                  "addr": "시설물 위치2",
                  "lat": 37.222222,
                  "lng": 127.222222,
                  "clfyCd": "분류코드",
                  "clfyNm" : "분류 명칭",
                  "useYn": true,
                  "state": "ON",
                  "updDtm": "20220302142822",
                  "data": null,
                  "locationCd" : "41222233",
                  "locationNm" : "지자체 명칭"
                },
                {
                  "facId": "테스트 시설물 id3",
                  "facNm": "테스트 시설물3",
                  "addr": "시설물 위치3",
                  "lat": 37.222222,
                  "lng": 127.222222,
                  "clfyCd": "분류코드",
                  "clfyNm" : "분류 명칭",
                  "useYn": true,
                  "state": "ON",
                  "updDtm": "20220302142822",
                  "data": null,
                  "locationCd" : "41222233",
                  "locationNm" : "지자체 명칭"
                }
              ]
        responses:
          200:
            description: 정상 요청의 response
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_200.json
          400:
            description: 요청 파라미터가 잘못된 경우
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_400.json
          401:
            description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_401.json
          500:
            description: 서버에러
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_500.json
      /facInfo:
        description: 시설물 분류에 묶인 시설물 정보 출력
        get:
          description: 시설물 분류에 묶인 시설물 리스트 출력
          headers:
            token:
              type: string
              description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
              required: true
          responses:
            200:
              description: 정상 요청의 response
              body:
                application/json:
                  type: gisInfo[]
                  example: !include ../../example/gg/gis/gisInfoList.json
            400:
              description: 요청 파라미터가 잘못된 경우
              body:
                application/json:
                  type: message
                  example: !include ../../example/gg/common/message_400.json
            401:
              description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
              body:
                application/json:
                  type: message
                  example: !include ../../example/gg/common/message_401.json
            500:
              description: 서버에러
              body:
                application/json:
                  type: message
                  example: !include ../../example/gg/common/message_500.json
    /all:
      description: 지도설정 화면에서 시설물 부분에 사용자 등록 시설물이라는 고정 댑스안에 이 api response를 트리구조로 표출해야합니다!
      get:
        description: 지도설정 부분에서 표출할 시설물 정보를 출력하는 api
        headers:
          token:
            type: string
            description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
            required: true
        responses:
          200:
            description: 정상 요청의 response
            body:
              application/json:
                type: clfyAll[]
                example: !include ../../example/gg/gis/fac/clfyAll.json
          400:
            description:  요청 파라미터가 잘못된 경우
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_400.json
          401:
            description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_401.json
          500:
            description: 서버에러
            body:
              application/json:
                type: message
                example: !include ../../example/gg/common/message_500.json
/user:
  description: 접근 사용자 정보 api
  get:
    description: gis 상황판은 접근하면서 사용자 정보를 가지고 있어야합니다,
      때문에 oms를 통한 이벤트 권한정보, 볼수있는 시설물 등 정해진 값을 관제하게합니다.
    headers:
      token:
        type: string
        description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
        required: true
    responses:
      200:
        description: 정상 요청의 response
        body:
          application/json:
            type: userInfo
            example: !include ../../example/gg/gis/user/userInfo.json
      400:
        description: 요청 파라미터가 잘못된 경우
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_400.json
      401:
        description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      500:
        description: 서버에러
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_500.json
  /search:
    description: 검색조건 , 이벤트 검색 조건을 저장 및 조회하는 api입니다. 등록, 조회할때 정보가 string 으로 저장된 json을 사용합니다. 화면에서 stringify 하여 사용합니다.
    get:
      description: 저장된 검색조건 조회
      headers:
        token:
          type: string
          description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
          required: true
      queryParameters:
        isFire:
          type: boolean
          description: 소방인지 아닌지
          required: true
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: searchConfig
              example: !include ../../example/gg/gis/user/searchConfig.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
    post:
      description: 검색조건 저장
      headers:
        token:
          type: string
          description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
          required: true
      body:
        application/json:
          type: searchConfig
          example: |
            {
              "isFire" : true,
              "clfy": "[{\"id\" : \"ff11\",\"nm\" : \"화재\"},{\"id\" : \"ff22\", \"nm\" : \"소방\"}]",
              "location" : "[{\"id\" : \"location1\",\"nm\" : \"광주\"},{\"id\" : \"location2\",\"nm\" : \"구리\"}]"
            }
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: message
              example:  !include ../../example/gg/common/message_post_success.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
/route:
  description: 사용자 경로 설정 //기존 locations으로 나뉘는 부분을 제거하고, route 단위로 변합
  post:
    description: 사용자 경로 저장, locations 정보를 함께 받습니다. reponse 값이 id가 아닌결과로 나옵니다.
    body:
      application/json:
        type: routeInfo
        example: |
          {
            "routeNm" :"경로명칭",
            "userId" : "등록자 명칭 식별값",
            "maintenanceTime" : 1,
            "locations": [
              {
                  "lon": "127.1",
                  "lat": "37.1",
                  "addr": "ansj address",
                  "index": 1
              },
              {
                  "lon": "127.2",
                  "lat": "37.2",
                  "addr": "ansj address2",
                  "index": 2
              }
            ]
          }
    responses:
      200:
        description: 정상 요청의 response
        body:
          application/json:
            type: message
            example:  !include ../../example/gg/common/message_post_success.json
      400:
        description: 요청 파라미터가 잘못된 경우
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_400.json
      401:
        description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      500:
        description: 서버에러
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_500.json
  get:
    description: 사용자 경로 목록 조회 //TODO 여기서부터 작성하면됨
    queryParameters:
      userId:
        type: string
        description: 사용자 식별값
        required: true
    responses:
      200:
        description: 정상 요청의 response
        body:
          application/json:
            type: routeInfo[]
            example: !include ../../example/gg/gis/route/routeList.json
      400:
        description: 요청 파라미터가 잘못된 경우
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_400.json
      401:
        description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      500:
        description: 서버에러
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_500.json
  /{routeId}:
    get:
      description: 사용자 경로 개별 조회
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: routeInfo
              example: !include ../../example/gg/gis/route/route.json
        400:
          description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
    put:
      description: 사용자 경로 수정 / locations은 변경후 결과 리스트가 반영됩니다(서버에서 delete 후 다시 등록입니다.)/get 으로 받은 결과 처럼 넣어도 되고, /route의 post 부분의 body
                     처럼 삽입해도 무방합니다. id 값이 있다면 그걸로 적용되고 , 없으면 알아서 채우고, routeId도 uriParameter를 잡아서 등록합니다.
      queryParameters:
        routeNm:
          type : string
          description: 변경 경로 명칭
      body:
        application/json:
          type: routeLocation[]
          example: |
            [
              {
                "locId": "645a28ff2a6c45878dd3b95658854fbe",
                "routeId": "0716c859e8504e3eb97b3f138d5f47fe",
                "lon": "123.1",
                "lat": "37.1",
                "addr": "ansj 변경",
                "index": 1
              },
              {
                "lon": "123.1",
                "lat": "37.1",
                "addr": "ansj 변경",
                "index": 2
              }
            ]
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_200.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
    delete:
      description: 사용자 경로 삭제 / 맵핑되는 locations 정보까지 삭제됩니다.
      responses:
        200:
          description: 정상 요청의 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_200.json
        400:
          description: 요청 파라미터가 잘못된 경우
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_400.json
        401:
          description:  토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_401.json
        500:
          description: 서버에러
          body:
            application/json:
              type: message
              example: !include ../../example/gg/common/message_500.json
