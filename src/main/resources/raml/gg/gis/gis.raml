      channelId:
        type: string
        description: 카메라 ID
      station:
        type: string
        description: 관할서
      car:
        type: string
        description: 차량종류
      carnum:
        type: string
        description: 차량번호
      connect:
        type: string
        description: 접속유무
      rtspAddr:
        type: string
        description: 영상접속 RTSP URL


/cctv:
  description: 지오맥스 쪽으로 부터 받는 CCTV 정보 cctvId로 영상 플레이, 지도상에 표출할때 사용
  get:
    description: cctv 목록 조회
    headers:
      token:
        type: string
        description: 플랫폼을 통한 접근으로  OMS에서 발급하는 token
        required: true
    queryParameters:
      type:
        type : string
        description: 필터 cctv 분류
        required: false
      locationCd:
        type: string
        description: 필터 지자체
        required: false
      cctvNm:
        type : string
        description: cctv 명칭
        required: false
      page:
        type: number
        description: 페이징 요청 값, 만약 -1로 요청하는경우 row 값을 무시하고 전체 결과를 반환합니다.
        required: false
      rows:
        type : number
        description: 페이징 요청 값
        required: false
    responses:
      200:
        description: 정상 요청의 response
        body:
          application/json:
            type: gisInfo[]
            example: !include ../../example/gg/gis/gisInfoList.json
      401:
        description: 토큰 없이 요청을 보내거나, 만료된 토큰으로 , 권한 확인불가 response
        body:
          application/json:
            type: message
            example: !include ../../example/gg/common/message_401.json
      400:
        description: 요청 파라미터가 잘못된 경우
