  "scripts": {
    "start": "node scripts/start.js",
    "build": "pnpm run typecheck && pnpm -r --if-present --filter \"./packages/**\" run build",
    "test": "node scripts/test.js",
    "build:legacy": "node scripts/build.js",
    "typecheck": "pnpm --filter @reapi/shared build && pnpm -r --if-present --filter \"./packages/**\" run typecheck"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@types/jquery": "^3.5.14",
    "@types/leaflet": "^1.5.23",
    "@types/leaflet-draw": "^1.0.3",
    "@types/leaflet.markercluster": "^1.4.4",
